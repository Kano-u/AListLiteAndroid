<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ios_surface"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_userscript_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ios_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_userscript_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ios_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.kyleduo.switchbutton.SwitchButton
        android:id="@+id/sb_userscript_enabled"
        style="@style/SwitchButtonStyle"
        android:layout_width="56dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:focusable="false"
        app:kswAnimationDuration="250"
        app:kswBackDrawable="@drawable/ios_back_drawable"
        app:kswThumbDrawable="@drawable/ios_thumb_selector"
        app:kswThumbMarginLeft="2dp"
        app:kswThumbMarginBottom="1dp"
        app:kswThumbMarginTop="3dp" />
</LinearLayout>
